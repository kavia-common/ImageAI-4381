 "scopeKind": "class"}, {"name": "_create_training_instances(self, train_annot_folder, train_image_folder, train_cache, valid_annot_folder, valid_image_folder, valid_cache, labels, )", "description": "Parses annotation files to generate training and validation datasets, also handling label overlaps.", "scope": "DetectionModelTrainer", "scopeKind": "class"}, {"name": "_create_callbacks(self, saved_weights_name, model_to_save)", "description": "Defines callbacks for model checkpointing, learning rate reduction, and TensorBoard logging.", "scope": "DetectionModelTrainer", "scopeKind": "class"}, {"name": "_create_model( self, nb_class, anchors, max_box_per_image, max_grid, batch_size, warmup_batches, ignore_thresh, multi_gpu, lr, grid_scales, obj_scale, noobj_scale, xywh_scale, class_scale )", "description": "Constructs a YOLOv3 model (single or multi-GPU), loads pre-trained weights if available, and compiles with Adam optimizer.", "scope": "DetectionModelTrainer", "scopeKind": "class"}, {"name": "label_color(self, label)", "description": "Returns an RGB color for the specified label index; defaults to green (0,255,0) if index is out of range, with a warning printed.", "scope": "CustomDetectionUtils", "scopeKind": "class"}, {"name": "draw_boxes_and_caption(self, image_frame, v_boxes, v_labels, v_scores, show_names=False, show_percentage=False)", "description": "Draws bounding boxes and optional labels and scores on an image frame for a list of detected objects. Uses different text options based on parameters show_names and show_percentage.", "scope": "CustomDetectionUtils", "scopeKind": "class"}, {"name": "__init__(self)", "scope": "DetectionModelTrainer", "scopeKind": "class", "description": "unavailable"}, {"name": "__init__(self, labels)", "scope": "CustomDetectionUtils", "scopeKind": "class", "description": "unavailable"}, {"name": "__init__(self, xmin, ymin, xmax, ymax, objness=None, classes=None)", "scope": "BoundBox", "scopeKind": "class", "description": "unavail